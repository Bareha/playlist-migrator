# Copy to .env and fill in after completing the manual setup steps in README.md.

# Spotify app "Client ID" from https://developer.spotify.com/dashboard
# (PKCE flow — no client secret needed or used).
VITE_SPOTIFY_CLIENT_ID=

# Google Cloud OAuth Client ID (type "Chrome Extension") from
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_OAUTH_CLIENT_ID=
